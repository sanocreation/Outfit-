# TRYON AI Backend Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
MAX_IMAGE_SIZE_MB=10

# Safe Default: keep DEMO_MODE=true until external GPU worker is connected
DEMO_MODE=true

# Active Provider: "demo" or "catvton"
VTON_PROVIDER=demo

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:8000,http://10.0.2.2:8000,http://localhost:3000

# Base URL used for public result links returned to client
BASE_URL=http://10.0.2.2:8000

# CatVTON External GPU Worker Configuration (Phase 3)
# The external GPU worker (Google Colab T4 / RunPod / Replicate) URL
CATVTON_WORKER_URL=
# Optional worker authentication token/key (NEVER exposed to client)
CATVTON_WORKER_API_KEY=
# Inference and network timeout in seconds
CATVTON_WORKER_TIMEOUT_SECONDS=120
# Status polling frequency in seconds
CATVTON_WORKER_POLL_INTERVAL_SECONDS=2

# Failsafe: if GPU worker is offline/unreachable, gracefully fallback to demo preview
AUTO_FALLBACK_TO_DEMO=true
